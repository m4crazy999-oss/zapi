rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica se a requisição pertence a um usuário autenticado.
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é o dono do documento informado pelo uid.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Valida formato canônico do @usuário (3 a 20 caracteres: letras minúsculas, números, ponto ou sublinhado).
    function isValidUsername(username) {
      return username is string
        && username.matches('^[a-z0-9._]{3,20}$');
    }

    // Novo: valida formato do ID público único ("ZP-" + 8 caracteres alfanuméricos sem ambiguidade).
    function isValidPublicId(publicId) {
      return publicId is string
        && publicId.matches('^ZP-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{8}$');
    }

    // Valida o ID determinístico de conversa 1 a 1 (menorUid_maiorUid) garantindo participação do usuário atual.
    function isValidDirectChatId(chatId) {
      return isSignedIn()
        && (chatId.matches('^' + request.auth.uid + '_[^_]+$')
            || chatId.matches('^[^_]+_' + request.auth.uid + '$'));
    }

    // Verifica se o usuário autenticado faz parte da lista de dois participantes do chat.
    function isChatParticipant(chatData) {
      return isSignedIn()
        && chatData != null
        && chatData.participants is list
        && chatData.participants.size() == 2
        && request.auth.uid in chatData.participants;
    }

    // Retorna o UID do outro participante em uma conversa 1 a 1.
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    // Verifica se o destinatário bloqueou o remetente.
    function isBlockedByOther(otherUid) {
      return exists(/databases/$(database)/documents/users/$(otherUid))
        && request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.get('blockedUids', []);
    }

    // Valida foto de perfil em base64 (<= 100 KB binário ≈ 160.000 chars em base64).
    function isValidProfilePhotoBase64(val) {
      return val == null || (val is string && val.size() <= 160000);
    }

    // Valida banner de perfil em base64 (<= 320 KB binário ≈ 440.000 chars em base64).
    function isValidProfileBannerBase64(val) {
      return val == null || (val is string && val.size() <= 440000);
    }

    // Valida os metadados e referências de mídia em mensagens (chats/{chatId}/media/{mediaId}).
    function isValidMessageMedia(data) {
      let mediaId = data.get('mediaId', null);
      let thumbB64 = data.get('thumbnailBase64', null);
      let assetPath = data.get('assetPath', null);
      return data.type in ['text', 'image', 'audio', 'sticker']
        && (mediaId == null || (mediaId is string && mediaId.size() > 0 && mediaId.size() <= 128))
        && (thumbB64 == null || (thumbB64 is string && thumbB64.size() <= 32000))
        && (assetPath == null || (assetPath is string && assetPath.matches('^asset://assets/stickers/.*\\.png$')))
        && (!('width' in data) || data.width == null || (data.width is int && data.width > 0 && data.width <= 1600))
        && (!('height' in data) || data.height == null || (data.height is int && data.height > 0 && data.height <= 1600))
        && (!('durationMs' in data) || data.durationMs == null || (data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 180000))
        && (!('sizeBytes' in data) || data.sizeBytes == null || (
          data.sizeBytes is int && data.sizeBytes >= 0 && (
            (data.type == 'image' && data.sizeBytes <= 700 * 1024)
            || (data.type == 'audio' && data.sizeBytes <= 900 * 1024)
            || (data.type == 'sticker' && data.sizeBytes <= 100 * 1024)
            || (data.type == 'text' && data.sizeBytes == 0)
          )
        ));
    }

    // Valida documento de mídia dedicado em chats/{chatId}/media/{mediaId}.
    function isValidMediaDocument(chatId, mediaId, data) {
      return data.keys().hasOnly([
          'id', 'chatId', 'messageId', 'senderId', 'type', 'mimeType',
          'data', 'sizeBytes', 'width', 'height', 'durationMs', 'createdAt'
        ])
        && data.id == mediaId
        && data.chatId == chatId
        && data.messageId is string
        && data.senderId == request.auth.uid
        && data.type in ['image', 'audio', 'sticker']
        && data.mimeType is string
        && data.data is string
        && data.data.size() > 0
        && data.data.size() <= 980000
        && data.sizeBytes is int
        && data.sizeBytes > 0
        && (
          (data.type == 'image' && data.sizeBytes <= 700 * 1024)
          || (data.type == 'audio' && data.sizeBytes <= 900 * 1024)
          || (data.type == 'sticker' && data.sizeBytes <= 100 * 1024)
        );
    }

    // Alterado: remove email e allowEmailSearch do users/{uid} e exige publicId válido na criação.
    function isValidUserCreate(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'displayName', 'username', 'publicId', 'photoBase64', 'photoUrl',
          'about', 'bannerPreset', 'bannerBase64', 'createdAt', 'lastSeen', 'blockedUids', 'activeChatId'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 50
        && isValidUsername(data.username)
        && isValidPublicId(data.publicId)
        && isValidProfilePhotoBase64(data.get('photoBase64', null))
        && (data.get('photoUrl', null) == null || data.photoUrl is string)
        && data.about is string
        && data.about.size() <= 140
        && (!('bannerPreset' in data) || data.bannerPreset == null || (data.bannerPreset is string && data.bannerPreset.size() <= 32))
        && isValidProfileBannerBase64(data.get('bannerBase64', null))
        && data.createdAt is timestamp
        && data.lastSeen is timestamp
        && (!('blockedUids' in data) || data.blockedUids is list)
        && (!('activeChatId' in data) || data.activeChatId == null || data.activeChatId is string);
    }

    // Alterado: proíbe email/allowEmailSearch após gravação, mantém publicId imutável após definido e permite migração de contas antigas pelo dono.
    function isValidUserUpdate(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'displayName', 'username', 'publicId', 'photoBase64', 'photoUrl',
          'about', 'bannerPreset', 'bannerBase64', 'createdAt', 'lastSeen', 'blockedUids', 'activeChatId'
        ])
        && data.uid == resource.data.uid
        && data.createdAt == resource.data.createdAt
        && isValidPublicId(data.publicId)
        && (
          !('publicId' in resource.data)
          || resource.data.publicId == null
          || resource.data.publicId == ''
          || data.publicId == resource.data.publicId
        )
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 50
        && isValidUsername(data.username)
        && isValidProfilePhotoBase64(data.get('photoBase64', null))
        && (data.get('photoUrl', null) == null || data.photoUrl is string)
        && data.about is string
        && data.about.size() <= 140
        && (!('bannerPreset' in data) || data.bannerPreset == null || (data.bannerPreset is string && data.bannerPreset.size() <= 32))
        && isValidProfileBannerBase64(data.get('bannerBase64', null))
        && data.lastSeen is timestamp
        && (!('blockedUids' in data) || data.blockedUids is list)
        && (!('activeChatId' in data) || data.activeChatId == null || data.activeChatId is string);
    }

    match /users/{uid} {
      // Permite leitura pontual de perfil público (sem e-mail) apenas para usuários autenticados.
      allow get: if isSignedIn();

      // Alterado: bloqueia totalmente qualquer consulta/listagem em users (remove busca por e-mail).
      allow list: if false;

      // Permite criação do próprio perfil apenas pelo dono e com schema privado validado.
      allow create: if isOwner(uid) && isValidUserCreate(uid);

      // Permite edição e limpeza de migração do próprio perfil apenas pelo dono.
      allow update: if isOwner(uid) && isValidUserUpdate(uid);

      // Permite exclusão do próprio documento de perfil durante encerramento da conta.
      allow delete: if isOwner(uid);

      // Novo: subcoleção privada de dados da conta (e-mail), legível e gravável exclusivamente pelo dono.
      match /private/{docId} {
        allow get: if isOwner(uid) && docId == 'account';
        allow list: if false;
        allow create, update: if isOwner(uid)
          && docId == 'account'
          && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
          && request.resource.data.email is string
          && request.resource.data.email.size() >= 5
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(uid) && docId == 'account';
      }

      match /contacts/{contactUid} {
        // Permite ler contatos exclusivamente pelo próprio dono da agenda.
        allow read: if isOwner(uid);

        // Permite adicionar ou editar contato apenas pelo dono, impedindo adicionar a si mesmo.
        allow create, update: if isOwner(uid)
          && contactUid != uid
          && request.resource.data.keys().hasOnly([
            'contactUid', 'nickname', 'displayName', 'username',
            'photoBase64', 'photoUrl', 'about', 'isFavorite', 'addedAt'
          ])
          && request.resource.data.contactUid == contactUid
          && (request.resource.data.nickname == null || request.resource.data.nickname is string)
          && request.resource.data.displayName is string
          && request.resource.data.username is string
          && isValidProfilePhotoBase64(request.resource.data.get('photoBase64', null))
          && (request.resource.data.get('photoUrl', null) == null || request.resource.data.photoUrl is string)
          && request.resource.data.about is string
          && (!('isFavorite' in request.resource.data) || request.resource.data.isFavorite is bool)
          && request.resource.data.addedAt is timestamp;

        // Permite remover contato exclusivamente pelo dono da agenda.
        allow delete: if isOwner(uid);
      }

      match /stickers/{stickerId} {
        // Permite gerenciar figurinhas próprias exclusivamente pelo dono.
        allow read, delete: if isOwner(uid);

        // Figurinhas próprias em WebP 512x512 (< 100 KB) ou favoritas nativas.
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'id', 'data', 'assetPath', 'mimeType', 'sizeBytes',
            'isFavorite', 'isBuiltIn', 'createdAt', 'lastUsedAt'
          ])
          && request.resource.data.id == stickerId
          && request.resource.data.isFavorite is bool
          && request.resource.data.isBuiltIn is bool
          && (
            (
              request.resource.data.isBuiltIn == true
              && request.resource.data.get('assetPath', null) is string
              && request.resource.data.assetPath.matches('^asset://assets/stickers/.*\\.png$')
            )
            ||
            (
              request.resource.data.isBuiltIn == false
              && request.resource.data.get('data', null) is string
              && request.resource.data.data.size() > 0
              && request.resource.data.data.size() <= 145000
              && request.resource.data.get('mimeType', '') == 'image/webp'
              && request.resource.data.get('sizeBytes', 0) is int
              && request.resource.data.sizeBytes <= 100 * 1024
            )
          );
      }
    }

    match /usernames/{username} {
      // Alterado: leitura pontual de @usuário permitida apenas para usuários autenticados.
      allow get: if isSignedIn() && isValidUsername(username);

      // Bloqueia listagem (list) da coleção para impedir coleta/enumeração em massa de usuários.
      allow list: if false;

      // Alterado: reserva de @usuário agora guarda somente {uid, createdAt}, sem e-mail.
      allow create: if isSignedIn()
        && isValidUsername(username)
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;

      // Alterado: permite ao dono apenas limpar o campo legado email durante a migração (mantendo uid e createdAt).
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;

      // Permite remover o registro de @usuário apenas ao seu atual dono (troca de @usuário ou exclusão de conta).
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Novo: índice direto por ID público único (ZP-XXXXXXXX) para busca de contatos sem varredura.
    match /publicIds/{publicId} {
      allow get: if isSignedIn() && isValidPublicId(publicId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidPublicId(publicId)
        && !exists(/databases/$(database)/documents/publicIds/$(publicId))
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      // Permite ler metadados do chat apenas aos dois participantes (inclusive antes da 1ª mensagem via ID válido).
      allow get: if isValidDirectChatId(chatId)
        && (resource == null || isChatParticipant(resource.data));

      // Permite listar conversas exclusivamente onde o usuário autenticado está em participants.
      allow list: if isChatParticipant(resource.data);

      // Permite criar a conversa 1 a 1 apenas aos participantes e se o destinatário não bloqueou o remetente.
      allow create: if isValidDirectChatId(chatId)
        && isChatParticipant(request.resource.data)
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && !isBlockedByOther(otherParticipant(request.resource.data.participants));

      // Permite atualizar última mensagem, contadores e digitação aos participantes, bloqueando novas mensagens se houver bloqueio.
      allow update: if isChatParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants
        && (
          request.resource.data.get('lastMessageId', '') == resource.data.get('lastMessageId', '')
          || !resource.data.get('blockedBy', {}).get(otherParticipant(resource.data.participants), false)
        );

      // Bloqueia exclusão direta do documento principal do chat pelo cliente.
      allow delete: if false;

      match /media/{mediaId} {
        // Apenas participantes da conversa podem ler documentos de mídia.
        allow read: if isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);

        // Permite gravar mídia em base64 apenas ao remetente participante, respeitando limites de tamanho.
        allow create: if isValidDirectChatId(chatId)
          && isChatParticipant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data)
          && isValidMediaDocument(chatId, mediaId, request.resource.data)
          && !getAfter(/databases/$(database)/documents/chats/$(chatId)).data
              .get('blockedBy', {})
              .get(otherParticipant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants), false)
          && !isBlockedByOther(otherParticipant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants));

        // Documentos de mídia são imutáveis.
        allow update: if false;

        // Permite ao remetente apagar a mídia quando escolher "Apagar para todos".
        allow delete: if isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && resource.data.senderId == request.auth.uid;
      }

      match /messages/{messageId} {
        // Permite ler mensagens exclusivamente aos participantes da conversa pai.
        allow read: if isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);

        // Permite criar mensagem de texto ou mídia apenas pelo remetente participante, validando tamanhos.
        allow create: if isValidDirectChatId(chatId)
          && isChatParticipant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && isValidMessageMedia(request.resource.data)
          && request.resource.data.status == 'sent'
          && request.resource.data.deletedForEveryone == false
          && !getAfter(/databases/$(database)/documents/chats/$(chatId)).data
              .get('blockedBy', {})
              .get(otherParticipant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants), false)
          && !isBlockedByOther(otherParticipant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants));

        // Permite recibos (entregue/lida/áudio ouvido) ou ocultar para si; apagar para todos é exclusivo do remetente.
        allow update: if isChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.chatId == resource.data.chatId
          && request.resource.data.clientCreatedAt == resource.data.clientCreatedAt
          && (
            (
              // Recibos (entregue/lida/áudio ouvido) ou ocultação local (apagar para mim).
              request.resource.data.text == resource.data.text
              && request.resource.data.deletedForEveryone == resource.data.deletedForEveryone
              && (request.resource.data.deletedFor.hasAll(resource.data.deletedFor))
              && (
                request.resource.data.deletedFor.size() == resource.data.deletedFor.size()
                || request.auth.uid in request.resource.data.deletedFor
              )
              && request.resource.data.get('playedBy', []).hasAll(resource.data.get('playedBy', []))
              && (
                request.resource.data.get('playedBy', []).size() == resource.data.get('playedBy', []).size()
                || request.auth.uid in request.resource.data.get('playedBy', [])
              )
            )
            ||
            (
              // Apagar para todos permitido exclusivamente para o remetente original da mensagem.
              resource.data.senderId == request.auth.uid
              && request.resource.data.deletedForEveryone == true
              && request.resource.data.text == ''
              && request.resource.data.get('mediaId', null) == null
              && request.resource.data.get('thumbnailBase64', null) == null
              && request.resource.data.get('assetPath', null) == null
              && request.resource.data.get('mediaUrl', null) == null
              && request.resource.data.get('thumbnailUrl', null) == null
            )
          );

        // Impede remoção física de documentos de mensagem (exclusão usa deletedFor ou deletedForEveryone).
        allow delete: if false;
      }
    }

    // Status temporários (24h) com controle de quem pode visualizar e registro de visualizações.
    match /statuses/{statusId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.get('allowedUids', [])
        );

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'ownerUid', 'ownerName', 'ownerUsername', 'ownerPhotoBase64',
          'type', 'text', 'backgroundColor', 'imageBase64', 'privacyMode',
          'allowedUids', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.id == statusId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerUsername is string
        && isValidProfilePhotoBase64(request.resource.data.get('ownerPhotoBase64', null))
        && request.resource.data.type in ['text', 'image']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.backgroundColor is int
        && (
          request.resource.data.get('imageBase64', null) == null
          || (
            request.resource.data.imageBase64 is string
            && request.resource.data.imageBase64.size() <= 620000
          )
        )
        && request.resource.data.privacyMode in ['all', 'favorites', 'custom']
        && request.resource.data.allowedUids is list
        && request.resource.data.allowedUids.size() <= 500
        && request.auth.uid in request.resource.data.allowedUids
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /views/{viewerUid} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.ownerUid == request.auth.uid;

        allow create, update: if isOwner(viewerUid)
          && request.auth.uid in get(/databases/$(database)/documents/statuses/$(statusId)).data.get('allowedUids', [])
          && request.resource.data.keys().hasOnly([
            'viewerUid', 'viewerName', 'viewerPhotoBase64', 'viewedAt'
          ])
          && request.resource.data.viewerUid == request.auth.uid
          && request.resource.data.viewerName is string
          && isValidProfilePhotoBase64(request.resource.data.get('viewerPhotoBase64', null))
          && request.resource.data.viewedAt is timestamp;

        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.ownerUid == request.auth.uid;
      }
    }

    // Nega qualquer acesso a coleções não declaradas explicitamente por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
